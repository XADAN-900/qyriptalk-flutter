{
  "rules": {
    ".read": false,
    ".write": false,
    "authMap": {
      "$a": {
        ".read": "auth != null && auth.uid === $a",
        ".write": "auth != null && ((auth.uid === $a && newData.isString() && auth.token.email === newData.val().toLowerCase() + (root.child('authV').child(newData.val() + '').exists() ? '.' + root.child('authV').child(newData.val() + '').val() : '') + '@users.qyriptalk.app') || ((auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin')) && !newData.exists()) || (auth.uid === $a && !newData.exists()))"
      }
    },
    "authV": {
      ".read": true,
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))"
    },
    "usernames": {
      ".read": true,
      "$name": {
        "$uid": {
          ".write": "auth != null && root.child('authMap').child(auth.uid).val() === $uid || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))"
        }
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "(auth != null && root.child('authMap').child(auth.uid).val() === $uid) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))",
        "password": {
          ".validate": false
        },
        "role": {
          ".validate": "newData.val() === data.val() || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin')) || (!data.exists() && newData.val() === 'user')"
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === root.child('authMap').child(auth.uid).val()) || data.child('createdBy').val() === root.child('authMap').child(auth.uid).val() || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin')))",
        "messages": {
          "$msg": {
            ".write": "(auth != null && root.child('rooms').child($room).child('users').child(root.child('authMap').child(auth.uid).val() + '').exists()) && (data.exists() ? (data.child('senderUid').val() === root.child('authMap').child(auth.uid).val() || root.child('rooms').child($room).child('createdBy').val() === root.child('authMap').child(auth.uid).val()) : newData.child('senderUid').val() === root.child('authMap').child(auth.uid).val())",
            "readBy": {
              "$u": {
                ".write": "(auth != null && root.child('rooms').child($room).child('users').child(root.child('authMap').child(auth.uid).val() + '').exists()) && $u === root.child('authMap').child(auth.uid).val()"
              }
            },
            "reactions": {
              "$u": {
                ".write": "(auth != null && root.child('rooms').child($room).child('users').child(root.child('authMap').child(auth.uid).val() + '').exists()) && $u === root.child('authMap').child(auth.uid).val()"
              }
            }
          }
        },
        "users": {
          "$u": {
            ".write": "auth != null && (($u === root.child('authMap').child(auth.uid).val() && !root.child('rooms').child($room).child('bannedUsers').child($u).exists()) || root.child('rooms').child($room).child('createdBy').val() === root.child('authMap').child(auth.uid).val())"
          }
        },
        "typing": {
          "$u": {
            ".write": "(auth != null && root.child('rooms').child($room).child('users').child(root.child('authMap').child(auth.uid).val() + '').exists()) && $u === root.child('authMap').child(auth.uid).val()"
          }
        },
        "pinnedMessage": {
          ".write": "auth != null && root.child('rooms').child($room).child('users').child(root.child('authMap').child(auth.uid).val() + '').exists()"
        },
        "bannedUsers": {
          ".write": "auth != null && root.child('rooms').child($room).child('createdBy').val() === root.child('authMap').child(auth.uid).val()"
        }
      }
    },
    "privateMessages": {
      "$dm": {
        ".read": "auth != null && ($dm.beginsWith(root.child('authMap').child(auth.uid).val() + '_') || $dm.endsWith('_' + root.child('authMap').child(auth.uid).val()))",
        ".write": "(auth != null && ($dm.beginsWith(root.child('authMap').child(auth.uid).val() + '_') || $dm.endsWith('_' + root.child('authMap').child(auth.uid).val())) && !root.child('users').child(($dm.beginsWith(root.child('authMap').child(auth.uid).val() + '_') ? $dm.replace(root.child('authMap').child(auth.uid).val() + '_', '') : $dm.replace('_' + root.child('authMap').child(auth.uid).val(), ''))).child('blocked').child(root.child('authMap').child(auth.uid).val() + '').exists()) || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))"
      }
    },
    "calls": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "callInvites": {
      "$uid": {
        ".read": "auth != null && root.child('authMap').child(auth.uid).val() === $uid",
        ".write": "auth != null"
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && root.child('authMap').child(auth.uid).val() === $uid",
        ".write": "auth != null && root.child('authMap').child(auth.uid).val() === $uid"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$a": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === $a && !root.child('admins').exists()))"
      }
    },
    "bans": {
      ".read": "auth != null",
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))"
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))"
    },
    "crashReports": {
      ".read": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))",
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))",
      "$r": {
        ".write": "auth != null && (!data.exists() || (auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin')))"
      }
    },
    "reports": {
      ".read": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))",
      ".write": "(auth != null && (auth.token.email === 'admin@panel.xadan.app' || root.child('admins').child(auth.uid).exists() || root.child('users').child(root.child('authMap').child(auth.uid).val() + '').child('role').val() === 'admin'))",
      "$r": {
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
